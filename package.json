{
  "name": "human-recognition-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based bedroom camera that records every visit, plus a small home server and dashboard for the camera feed, Minecraft server, AC, door switch and Govee lights.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js server/test/*.test.js",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "serve": "node tests/e2e/serve.mjs",
    "server": "node server/index.js",
    "server:mock": "HOME_SERVER_CONFIG=server/config.mock.json node server/index.js",
    "test:e2e:dashboard": "node tests/e2e/dashboard.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
